@page
@model StudentGradeTrackingSystem.Pages.Courses.IndexModel
@{
    ViewData["Title"] = "Courses";
}

<h1>Courses</h1>
<a class="btn btn-primary mb-3" asp-page="Create"><i class="fas fa-plus"></i> Add Course</a>
<div class="row row-cols-1 row-cols-md-3 g-4">
@foreach (var course in Model.Courses)
{
    <div class="col">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">@course.CourseName</h5>
                <div class="d-flex justify-content-end gap-2">
                    <a class="btn btn-info btn-sm" asp-page="Details" asp-route-id="@course.Id"><i class="fas fa-eye"></i></a>
                    <a class="btn btn-warning btn-sm" asp-page="Edit" asp-route-id="@course.Id"><i class="fas fa-edit"></i></a>
                    <a class="btn btn-danger btn-sm" asp-page="Delete" asp-route-id="@course.Id"><i class="fas fa-trash"></i></a>
                </div>
            </div>
        </div>
    </div>
}
</div>
