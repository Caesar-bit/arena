@page
@model StudentGradeTrackingSystem.Pages.Courses.DeleteModel
@{
    ViewData["Title"] = "Delete Course";
}

<h1>Delete Course</h1>
<h3>Are you sure you want to delete this course?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Course Name</dt>
        <dd class="col-sm-10">@Model.Course.CourseName</dd>
        <dt class="col-sm-2">Grade Level</dt>
        <dd class="col-sm-10">@Model.Course.GradeLevel</dd>
        <dt class="col-sm-2">Midterm %</dt>
        <dd class="col-sm-10">@Model.Course.MidtermWeight</dd>
        <dt class="col-sm-2">Final %</dt>
        <dd class="col-sm-10">@Model.Course.FinalExamWeight</dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Course.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
