@page
@model StudentGradeTrackingSystem.Pages.Students.IndexModel
@{
    ViewData["Title"] = "Students";
}

<h1>Students</h1>
<a class="btn btn-primary mb-2" asp-page="Create">Add Student</a>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Full Name</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var student in Model.Students)
    {
        <tr>
            <td>@student.FullName</td>
            <td>
                <a class="btn btn-info btn-sm" asp-page="Details" asp-route-id="@student.Id">Details</a>
                <a class="btn btn-warning btn-sm" asp-page="Edit" asp-route-id="@student.Id">Edit</a>
                <a class="btn btn-danger btn-sm" asp-page="Delete" asp-route-id="@student.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
