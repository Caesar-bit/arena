@page
@model StudentGradeTrackingSystem.Pages.Students.IndexModel
@{
    ViewData["Title"] = "Students";
}

<h1>Students</h1>
<a class="btn btn-primary mb-3" asp-page="Create"><i class="fas fa-plus"></i> Add Student</a>
<div class="row row-cols-1 row-cols-md-3 g-4">
@foreach (var student in Model.Students)
{
    <div class="col">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">@student.FullName</h5>
                <p class="card-text">ID: @student.StudentNumber<br />Grade: @student.GradeLevel<br />@student.ContactEmail</p>
                <div class="d-flex justify-content-end gap-2">
                    <a class="btn btn-info btn-sm" asp-page="Details" asp-route-id="@student.Id"><i class="fas fa-eye"></i></a>
                    <a class="btn btn-warning btn-sm" asp-page="Edit" asp-route-id="@student.Id"><i class="fas fa-edit"></i></a>
                    <a class="btn btn-danger btn-sm" asp-page="Delete" asp-route-id="@student.Id"><i class="fas fa-trash"></i></a>
                </div>
            </div>
        </div>
    </div>
}
</div>
