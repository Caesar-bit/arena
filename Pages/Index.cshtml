@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<div class="hero text-center text-white">
    <h1 class="display-3 fw-bold">Student Grade Tracker</h1>
    <p class="lead mb-4">Manage students, courses and grades in one place.</p>

    @if (!User.Identity?.IsAuthenticated ?? true)
    {
        <a class="btn btn-primary btn-lg me-2" asp-page="/Account/Login"><i class="fas fa-sign-in-alt"></i> Login</a>
        <a class="btn btn-success btn-lg" asp-page="/Account/Register"><i class="fas fa-user-plus"></i> Register</a>
    }
    else
    {
        <a class="btn btn-primary btn-lg me-2" asp-page="/Dashboard/Index"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
        <form method="post" asp-page="/Account/Logout" class="d-inline">
            <button type="submit" class="btn btn-danger btn-lg"><i class="fas fa-sign-out-alt"></i> Logout</button>
        </form>
    }
</div>
