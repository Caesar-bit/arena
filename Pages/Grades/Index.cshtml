@page
@model StudentGradeTrackingSystem.Pages.Grades.IndexModel
@{
    ViewData["Title"] = "Grades";
}

<h1>Grades</h1>
<a class="btn btn-primary mb-3" asp-page="Create"><i class="fas fa-plus"></i> Add Grade</a>
<div class="row row-cols-1 row-cols-md-3 g-4">
@foreach (var grade in Model.Grades)
{
    <div class="col">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">@grade.Student?.FullName - @grade.Course?.CourseName</h5>
                <p class="card-text">@grade.AssessmentType (@grade.Weight%) - Score: <strong>@grade.Score</strong> (Weighted: @grade.WeightedScore.ToString("F2"))</p>
                <div class="d-flex justify-content-end gap-2">
                    <a class="btn btn-info btn-sm" asp-page="Details" asp-route-id="@grade.Id"><i class="fas fa-eye"></i></a>
                    <a class="btn btn-warning btn-sm" asp-page="Edit" asp-route-id="@grade.Id"><i class="fas fa-edit"></i></a>
                    <a class="btn btn-danger btn-sm" asp-page="Delete" asp-route-id="@grade.Id"><i class="fas fa-trash"></i></a>
                </div>
            </div>
        </div>
    </div>
}
</div>

<h2>Average Grade per Student</h2>
<canvas id="studentAvgChart" width="400" height="200"></canvas>

<h2>Average Grade per Course</h2>
<canvas id="courseAvgChart" width="400" height="200"></canvas>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const studentLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StudentAverages.Select(x => x.Student)));
        const studentData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StudentAverages.Select(x => x.Average)));
        const courseLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CourseAverages.Select(x => x.Course)));
        const courseData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CourseAverages.Select(x => x.Average)));

        new Chart(document.getElementById('studentAvgChart'), {
            type: 'bar',
            data: {
                labels: studentLabels,
                datasets: [{
                    label: 'Average Grade',
                    data: studentData,
                    backgroundColor: 'rgba(54, 162, 235, 0.5)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                scales: {
                    y: { beginAtZero: true, max: 100 }
                }
            }
        });

        new Chart(document.getElementById('courseAvgChart'), {
            type: 'bar',
            data: {
                labels: courseLabels,
                datasets: [{
                    label: 'Average Grade',
                    data: courseData,
                    backgroundColor: 'rgba(255, 99, 132, 0.5)',
                    borderColor: 'rgba(255, 99, 132, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                scales: {
                    y: { beginAtZero: true, max: 100 }
                }
            }
        });
    </script>
}
