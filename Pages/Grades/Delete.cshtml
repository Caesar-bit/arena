@page
@model StudentGradeTrackingSystem.Pages.Grades.DeleteModel
@{
    ViewData["Title"] = "Delete Grade";
}

<h1>Delete Grade</h1>
<h3>Are you sure you want to delete this grade?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Student</dt>
        <dd class="col-sm-10">@Model.Grade.Student?.FullName</dd>
        <dt class="col-sm-2">Course</dt>
        <dd class="col-sm-10">@Model.Grade.Course?.CourseName</dd>
        <dt class="col-sm-2">Score</dt>
        <dd class="col-sm-10">@Model.Grade.Score</dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Grade.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
