@page
@model StudentGradeTrackingSystem.Pages.Grades.EditModel
@{
    ViewData["Title"] = "Edit Grade";
}

<h1>Edit Grade</h1>
<form method="post">
    <input type="hidden" asp-for="Grade.Id" />
    <div class="form-group">
        <label asp-for="Grade.StudentId" class="control-label">Student</label>
        <select asp-for="Grade.StudentId" class="form-control" asp-items="Model.StudentOptions"></select>
        <span asp-validation-for="Grade.StudentId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Grade.CourseId" class="control-label">Course</label>
        <select asp-for="Grade.CourseId" class="form-control" asp-items="Model.CourseOptions"></select>
        <span asp-validation-for="Grade.CourseId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Grade.AssessmentType" class="control-label">Assessment</label>
        <select asp-for="Grade.AssessmentType" class="form-control" asp-items="Model.AssessmentOptions"></select>
        <span asp-validation-for="Grade.AssessmentType" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Grade.Weight" class="control-label">Weight (%)</label>
        <input asp-for="Grade.Weight" class="form-control" />
        <span asp-validation-for="Grade.Weight" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Grade.Score" class="control-label"></label>
        <input asp-for="Grade.Score" class="form-control" />
        <span asp-validation-for="Grade.Score" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
